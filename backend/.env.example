# ESPORA Database & Security
DATABASE_URL=postgresql://espora_user:espora_password@localhost:5432/espora_db
SECRET_KEY=supersecretkey_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mail Server (Mailpit o SMTP)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_SENDER=noreply@espora.unam.mx

# LimeSurvey Connector (Infraestructura C3)
LIMESURVEY_API_URL=https://lsapi.c3.unam.mx
# X-Api-Key provista por el C3
LIMESURVEY_API_KEY=tu_api_key_aqui
# Host RemoteControl 2 de LimeSurvey y credenciales para abrir sesión
LIMESURVEY_RPC_URL=https://ls-test.c3.unam.mx/admin/remotecontrol
LIMESURVEY_USERNAME=tabare
LIMESURVEY_PASSWORD=tu_password_de_limesurvey
# ID de la encuesta principal (ej. Ficha de Tamizaje / Ingreso)
LIMESURVEY_DEFAULT_SID=118334
# Token secreto para webhook entrante
LIMESURVEY_WEBHOOK_SECRET=supersecret123
